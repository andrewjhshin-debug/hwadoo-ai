rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 저장소(Storage) 규칙 — 사진이 사는 곳.
//
// 형: 「지금 실제 사진은 안 올라가는 거냐? 와꾸만 짜 봐. 한 5개 정도만
//      서버에 저장되도록 일단, 나중에 늘리더라도」
//
// **이 파일이 아예 없었다.** 코드는 사진을 올리고 있었는데(yeon.ts 의
// 사진올리기 → yeon/{uid}/{시각}.{확장자}) 저장소는 규칙을 받은 적이
// 없으니, 기본값대로 브라우저의 쓰기를 통째로 막고 있었다.
// 프로필에서 ＋ 를 눌러도 아무 일도 안 일어난 까닭이 이것이다.
//
// 규칙은 세 가지만 본다 —
//   ① 제 칸에만 쓴다 (yeon/{내 uid}/…)
//   ② 그림이어야 한다 (jpeg · png · webp)
//   ③ 8MB 까지 (yeon.ts 가 클라이언트에서 거르는 것과 같은 수)
//
// 읽기는 열지 않는다. 카드·내 프로필·심사 화면은 서버가 발급하는
// 몇 분짜리 주소로만 그림을 읽는다. 저장소 주소 하나가 떠돌아도
// 대기 사진이 열리지 않는 것이 이 문을 닫는 이유다.
// ─────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    // 올리는 쪽에서 이미 JPEG 로 다시 구워 보낸다(yeon.ts 다시굽기).
    // 그래도 규칙은 규칙대로 본다 — 코드를 못 믿어서가 아니라, 규칙이
    // 마지막 문이기 때문이다. 아이폰 HEIC 가 다시 굽기를 못 타고 그대로
    // 올 수 있으니 갈래는 image/* 로 넓히고, 크기로 조인다.
    function isPhoto() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    // ── 인연 프로필 사진 ────────────────────────────────────
    match /yeon/{uid}/{shot} {
      allow read: if false;
      // 파일 이름은 매번 새로 만든다. 한 번 올라간 파일을 브라우저가
      // 덮어쓰면 심사받은 얼굴을 다른 그림으로 바꿀 수 있으므로 create만.
      allow create: if signedIn()
        && request.auth.uid == uid
        && isPhoto();
      // 지우기는 서버가 프로필 목록과 실물을 함께 걷는다.
      allow update, delete: if false;
    }

    // 실시간 인증 사진 — 공개 사진과 완전히 분리한다. 본인과 관리자도
    // 저장소에서 직접 읽지 않고 서버 심사 화면의 짧은 주소만 쓴다.
    match /yeon-proof/{uid}/{shot} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid && isPhoto();
      allow update, delete: if false;
    }

    // ── 그 밖은 전부 잠근다 ─────────────────────────────────
    // 새 쓰임이 생기면 여기 위에 칸을 하나 더 판다. 열어 두고 잊는 것보다
    // 막아 두고 막혔다고 듣는 편이 언제나 싸다.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
