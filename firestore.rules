// ─────────────────────────────────────────────────────────────
// 화두 Firestore 규칙 — 전문(全文). 콘솔 > Firestore > 규칙 탭의
// 내용을 이 파일로 통째로 바꿔 넣고 [게시]하면 된다.
//
// 2026-08-20 통합본 v3:
// · posts 작성자 수정 허용 필드에 meetTime·lantern 추가
// · posts/{id}/likes/{uid} — 합장(좋아요) 계정당 한 번의 증거 문서
// · comments 의 up/down(좋아요·싫어요) 셈 올리기 허용
// · reports — 댓글 신고도 받도록 로그인 사용자 누구나 넣을 수 있게
// · wallets — 첫 지갑은 정확히 연꽃 3송이로만 스스로 만들 수 있다(첫 선물)
// · dm-threads / wallets / reports — 쪽지·연꽃 (dmOpen()으로 여닫음)
//
// 2026-08-23 v4: posts 작성자 수정 허용 필드에 rankHanja 추가
// 2026-08-23 v5: posts 작성자 수정 허용 필드에 category 추가
// 2026-08-24 v6: orders — 연꽃 계좌이체 주문
//
// 2026-09-12 v8:
// · push-tokens 에 bells(예불 종 시각 목록) 필드 — create 허용 필드에 추가,
//   bells 한 칸만 고치는 update 허용 (문서 ID = 토큰, 추측 불가한 값)
//
// 2026-09-07 v7 (출시 전 보안 감사 반영):
// · 관리자 이메일 판별에 email_verified 요구 — 미검증 이메일 사칭 차단
// · posts/comments create 에 authorUid == 본인 강제 — 작성자 위장 차단
// · posts 카운터(views/hapjang/commentCount) — ±1 증분만, 합장·댓글수는
//   로그인 필수 (조회수만 비로그인 +1 허용)
// · dm-threads create — 연꽃 1송이가 같은 batch 에서 차감되어야만 생성
//   (getAfter 검증, 뒷방은 예외) — 과금 우회 봉쇄
// · posts 작성자 수정 허용 필드에서 lantern 제거 — 공짜 연등 차단
// · orders create — 상품표(1/1,000 · 10/9,000 · 30/24,000)와 맞아야만
// · wallets update — lotus 한 칸만, 0 미만 금지
// · push-tokens create — 필드 제한 + uid 는 본인 것(또는 null)만
// · holding — count 한 칸, ±1 만
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 뒷방 주인인가 — 본계정(UID) 또는 부계정(검증된 이메일)
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == "HvYY1QPhLiMLc5NezM1jt0QdUiM2"
            || (request.auth.token.email == "iphonecharging1@gmail.com"
                && request.auth.token.email_verified == true));
    }

    // 뒷방 콘텐츠(은행 손질·선지식·후원자 명단) — 읽기는 모두, 쓰기는 뒷방만
    match /admin-content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 연지원 글 + 모임 — 읽기 모두, 쓰기는 로그인만(본인 이름으로만).
    // 카운터는 증분(±1)만, 모임 필드 고치기는 작성자만.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        // 조회수 — 비로그인 포함, 정확히 +1 만
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.get('views', 0) + 1)
        // 합장 — 로그인, ±1 (올리기/거두기)
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hapjang'])
            && request.resource.data.hapjang is int
            && (request.resource.data.hapjang == resource.data.get('hapjang', 0) + 1
                || request.resource.data.hapjang == resource.data.get('hapjang', 0) - 1))
        // 댓글 수 — 로그인, ±1
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount is int
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        // 작성자 본인의 글 손질 — lantern 은 뺐다(지급은 뒷방·서버만)
        || (request.auth != null
            && request.auth.uid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'templeName', 'meetDate', 'meetTime', 'body', 'openChatUrl', 'gender', 'rankHanja', 'category', 'deleted']));
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;
        // 좋아요·싫어요 셈(로그인) 또는
        // 작성자·뒷방의 소프트 삭제('삭제된 댓글입니다'로 바꾸기)
        allow update: if (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['up', 'down']))
          || ((isAdmin()
               || (request.auth != null
                   && request.auth.uid == resource.data.authorUid))
              && request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['deleted', 'body']));
        allow delete: if isAdmin();
      }

      // 합장(공감) — 계정당 한 번, 토글. 문서 하나가 '눌렀음'의 증거다.
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        // 다시 누르면 거둔다 — 제 것만
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid);
      }
    }

    // 나눔에 부쳐진 답 — 부치기는 누구나(비로그인 포함), 검수·삭제는 뒷방만
    match /shared-answers/{id} {
      allow read: if true;
      allow create: if request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // 던져진 화두 — 던지기는 누구나, 살피기·승인·삭제는 뒷방만
    match /thrown/{id} {
      allow create: if request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // 공개된 화두 — 읽기 모두, seen 증가는 누구나, 나머지는 뒷방만
    match /public-hwadu/{id} {
      allow read: if true;
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['seen']);
      allow create, delete: if isAdmin();
    }

    // 함께 드는 수 — 익명 카운터. count 한 칸, ±1 만.
    match /holding/{hwaduId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (request.resource.data.count == 1
            || request.resource.data.count == -1);
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (request.resource.data.count == resource.data.get('count', 0) + 1
            || request.resource.data.count == resource.data.get('count', 0) - 1);
    }

    // 문안 알림 토큰 — 만들고 내리기만. uid 는 본인 것(또는 null)만 새길 수 있다.
    // bells(예불 종 시각)는 그 문서를 아는 이(=토큰 주인 브라우저)만 고칠 수 있다.
    match /push-tokens/{token} {
      allow create: if request.resource.data.keys()
          .hasOnly(['createdAt', 'uid', 'ua', 'bells'])
        && (request.resource.data.uid == null
            || (request.auth != null
                && request.resource.data.uid == request.auth.uid));
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['bells'])
            && request.resource.data.bells is list
            && request.resource.data.bells.size() <= 8);
      allow delete: if true;
      allow read: if isAdmin();
    }

    // 계정 동기화 — 제 것만
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 죽비(피드백) — 보내기는 누구나, 읽기·지우기는 뒷방만
    match /feedback/{id} {
      allow create: if request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── 쪽지 — 공통 판별 ──
    function dmIsAdmin() {
      return request.auth != null
        && (request.auth.uid == "HvYY1QPhLiMLc5NezM1jt0QdUiM2"
            || (request.auth.token.email == "iphonecharging1@gmail.com"
                && request.auth.token.email_verified == true));
    }
    function dmOpen() {
      return true; // 쪽지 전체 개방 스위치 — config.ts DM_ENABLED 와 함께
    }
    function dmOn() {
      return dmOpen() || dmIsAdmin();
    }

    // ── 쪽지 대화 ──
    match /dm-threads/{threadId} {
      // 읽기 — 내 대화만(청한 이·받는 이·멤버). 뒷방은 신고 처리를 위해 전부.
      allow read: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && (request.auth.uid == resource.data.requesterUid
                || request.auth.uid == resource.data.ownerUid
                || request.auth.uid in resource.data.members));
      // 청 넣기 — 내가 requester, 멤버는 [나, 받는 이] 둘, 시작은 pending.
      // 값: 같은 batch 에서 내 지갑의 연꽃이 정확히 1 줄어야 한다(getAfter).
      // 뒷방은 연꽃 없이(도량을 살피는 손길).
      allow create: if dmOn() && request.auth != null
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.ownerUid in request.resource.data.members
        && request.resource.data.status == "pending"
        && (dmIsAdmin()
            || (get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus >= 1
                && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus
                   == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus - 1));
      // 고치기 — 멤버만. 멤버·역할은 못 바꾸고, 수락/거절(status)은 받는 이만.
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.requesterUid == resource.data.requesterUid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && (request.resource.data.status == resource.data.status
                || request.auth.uid == resource.data.ownerUid
                || request.resource.data.status == "blocked"));
      allow delete: if dmIsAdmin();

      // 쪽지 낱장 — 수락된 대화의 멤버만 오간다
      match /messages/{messageId} {
        allow read: if dmIsAdmin()
          || (dmOn() && request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members);
        allow create: if dmOn() && request.auth != null
          && request.auth.uid == request.resource.data.uid
          && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members
          && get(/databases/$(database)/documents/dm-threads/$(threadId)).data.status == "accepted";
        allow update, delete: if dmIsAdmin();
      }
    }

    // ── 연꽃 지갑 ──
    match /wallets/{uid} {
      // 내 지갑만 본다 — 뒷방은 채우기 위해 전부
      allow read: if request.auth != null
        && (request.auth.uid == uid || dmIsAdmin());
      // 첫 지갑은 정확히 연꽃 3송이로만 스스로 만들 수 있다(첫 선물) —
      // 문서가 이미 있으면 create 가 막히므로 두 번 받을 수 없다.
      // 채우기는 뒷방 · 본인은 한 송이 차감만(lotus 한 칸, 0 미만 금지).
      allow create: if dmIsAdmin()
        || (dmOn() && request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['lotus'])
            && request.resource.data.lotus == 3);
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['lotus'])
            && request.resource.data.lotus is int
            && request.resource.data.lotus >= 0
            && request.resource.data.lotus == resource.data.lotus - 1);
      allow delete: if dmIsAdmin();
    }

    // ── 연꽃 주문 — 계좌이체 입금 확인 대기열 ──
    match /orders/{orderId} {
      // 주문 넣기 — 로그인한 본인 이름으로, 시작은 pending.
      // 송이수·값은 상품표와 정확히 맞아야 한다 (조작 주문 차단).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == "pending"
        && ((request.resource.data.productId == "lotus-1"
             && request.resource.data.n == 1
             && request.resource.data.price == 1000)
          || (request.resource.data.productId == "lotus-10"
              && request.resource.data.n == 10
              && request.resource.data.price == 9000)
          || (request.resource.data.productId == "lotus-30"
              && request.resource.data.n == 30
              && request.resource.data.price == 24000));
      // 읽기 — 내 주문 + 뒷방 · 처리(지급·삭제)는 뒷방만
      allow read: if dmIsAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update, delete: if dmIsAdmin();
    }

    // ── 신고함 — 쪽지·댓글 신고가 함께 모인다 ──
    match /reports/{reportId} {
      // 신고 넣기 — 로그인한 본인 이름으로만 · 읽기·처리·삭제는 뒷방만
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.byUid
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }
  }
}
