// ─────────────────────────────────────────────────────────────
// 화두 Firestore 규칙 — 전문(全文). 콘솔 > Firestore > 규칙 탭의
// 내용을 이 파일로 통째로 바꿔 넣고 [게시]하면 된다.
//
// ★ 블록을 더했으면 **아래 변경기록에 한 줄을 반드시 남긴다.**
//   v11 의 candles 가 기록 없이 들어왔다가 게시를 통째로 건너뛰었고,
//   초 공양이 몇 날 동안 조용히 죽어 있었다(읽기 403). 기록이 없으면
//   게시했는지 안 했는지 아무도 되짚을 수 없다. 기록이 곧 점검표다.
//
// 2026-09-17 v14:
// · hall/{seatId} — 함께 켜는 초 여섯 자리(아픈 이·먼저 가신 분·시험·
//   마음·멀어진 사이·모든 중생). **읽기는 누구나, 쓰기는 서버만.**
//   모두가 겹쳐 쓰는 한 칸이라 브라우저에 열어 주면 콘솔 한 줄로
//   오늘 공덕이 백만이 된다. /api/merit/give 가 트랜잭션으로 적는다.
// · giving/{uid}_{날짜} — 하루 세 번 셈. 본인만 읽고, 쓰기는 서버만.
// · gifts/{uid}_{표} — 같은 요청 두 번 막는 멱등표. 아무도 못 읽는다.
//
// 2026-09-17 v13:
// · candles 등(tier 'light')의 until 상한을 8일 → 4일로. 초·등 모두 사흘만
//   탄다(candleSpec.ts BURN_DAYS/LIGHT_DAYS). 49일은 뜻은 맞아도 법당에
//   다시 올 까닭을 없앴다 — 오래 타는 것보다 자주 오는 쪽을 골랐다.
//
// 2026-09-16 v12:
// · candles create — 브라우저는 tier 'light'(회향 등, 공짜)만 세운다.
//   값이 드는 tier 'candle' 은 /api/candle/light 가 지갑 차감과 한
//   트랜잭션으로 쓴다(Admin SDK). 나눠 쓰다 연꽃만 사라지던 길을 닫았다.
//
// 2026-09-16 v11:
// · candles — 초 공양과 회향의 등. 같이 빌기는 hapjang ±1 한 칸.
// · isAdmin() 에 andrewjhshin@gmail.com 추가 —
//   src/lib/config.ts 의 ADMIN_EMAILS 에는 있는데 규칙에만 빠져 있었다.
//
// 2026-08-20 통합본 v3:
// · posts 작성자 수정 허용 필드에 meetTime·lantern 추가
// · posts/{id}/likes/{uid} — 합장(좋아요) 계정당 한 번의 증거 문서
// · comments 의 up/down(좋아요·싫어요) 셈 올리기 허용
// · reports — 댓글 신고도 받도록 로그인 사용자 누구나 넣을 수 있게
// · wallets — 첫 지갑은 정확히 연꽃 3송이로만 스스로 만들 수 있다(첫 선물)
// · dm-threads / wallets / reports — 쪽지·연꽃 (dmOpen()으로 여닫음)
//
// 2026-08-23 v4: posts 작성자 수정 허용 필드에 rankHanja 추가
// 2026-08-23 v5: posts 작성자 수정 허용 필드에 category 추가
// 2026-08-24 v6: orders — 연꽃 계좌이체 주문
//
// 2026-09-15 v10:
// · moments / moment-photos — 모멘트(절에 다녀온 한 장).
//   「그 자리」 도장(verified·meters)은 브라우저가 못 적는다 —
//   만들 때 false 로 굳히고, /api/moment-stamp 가 좌표를 다시 재어 뒤집는다.
//   사진은 문서 안에 담기므로 글자 수 천장을 규칙에서 눌러 둔다.
//
// 2026-09-15 v9:
// · 서버만 만지는 문서들을 명시해 잠그고 적어 둔다 —
//   temple-members(우리 절) · temple-proofs(절 다녀왔다는 표) ·
//   merit-exchange(공덕→연꽃 하루 상한) · sutra-clears(경전 완주) ·
//   rank-daily · rank-sutra(순위) · notify-limits(알림 상한)
//   모두 firebase-admin 으로만 쓴다. Admin SDK 는 규칙을 지나치므로
//   여기서는 **브라우저를 전부 막는다**. Firestore 기본값도 거절이지만,
//   적어 두어야 다음 사람이 ‘까물령나’ 하고 열지 않는다.
//
// 2026-09-12 v8:
// · push-tokens 에 bells(예불 종 시각 목록) 필드 — create 허용 필드에 추가,
//   bells 한 칸만 고치는 update 허용 (문서 ID = 토큰, 추측 불가한 값)
//
// 2026-09-07 v7 (출시 전 보안 감사 반영):
// · 관리자 이메일 판별에 email_verified 요구 — 미검증 이메일 사칭 차단
// · posts/comments create 에 authorUid == 본인 강제 — 작성자 위장 차단
// · posts 카운터(views/hapjang/commentCount) — ±1 증분만, 합장·댓글수는
//   로그인 필수 (조회수만 비로그인 +1 허용)
// · dm-threads create — 연꽃 1송이가 같은 batch 에서 차감되어야만 생성
//   (getAfter 검증, 뒷방은 예외) — 과금 우회 봉쇄
// · posts 작성자 수정 허용 필드에서 lantern 제거 — 공짜 연등 차단
// · orders create — 상품표(1/1,000 · 10/9,000 · 30/24,000)와 맞아야만
// · wallets update — lotus 한 칸만, 0 미만 금지
// · push-tokens create — 필드 제한 + uid 는 본인 것(또는 null)만
// · holding — count 한 칸, ±1 만
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 뒷방 주인인가 — 본계정(UID) 또는 부계정(검증된 이메일)
    // ※ 이 이메일 목록은 src/lib/config.ts 의 ADMIN_EMAILS 와 **같아야 한다.**
    //   앱에서만 주인이고 규칙에서는 남이면, 뒷방 단추가 보이는데 눌리지 않는다.
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == "HvYY1QPhLiMLc5NezM1jt0QdUiM2"
            || (request.auth.token.email in [
                  "iphonecharging1@gmail.com",
                  "andrewjhshin@gmail.com"
                ]
                && request.auth.token.email_verified == true));
    }

    // 뒷방 콘텐츠(은행 손질·선지식·후원자 명단) — 읽기는 모두, 쓰기는 뒷방만
    match /admin-content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 연지원 글 + 모임 — 읽기 모두, 쓰기는 로그인만(본인 이름으로만).
    // 카운터는 증분(±1)만, 모임 필드 고치기는 작성자만.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        // 조회수 — 비로그인 포함, 정확히 +1 만
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.get('views', 0) + 1)
        // 합장 — 로그인, ±1 (올리기/거두기)
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hapjang'])
            && request.resource.data.hapjang is int
            && (request.resource.data.hapjang == resource.data.get('hapjang', 0) + 1
                || request.resource.data.hapjang == resource.data.get('hapjang', 0) - 1))
        // 댓글 수 — 로그인, ±1
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount is int
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        // 작성자 본인의 글 손질 — lantern 은 뺐다(지급은 뒷방·서버만)
        || (request.auth != null
            && request.auth.uid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'templeName', 'meetDate', 'meetTime', 'body', 'openChatUrl', 'gender', 'rankHanja', 'category', 'deleted']));
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;
        // 좋아요·싫어요 셈(로그인) 또는
        // 작성자·뒷방의 소프트 삭제('삭제된 댓글입니다'로 바꾸기)
        allow update: if (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['up', 'down']))
          || ((isAdmin()
               || (request.auth != null
                   && request.auth.uid == resource.data.authorUid))
              && request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['deleted', 'body']));
        allow delete: if isAdmin();
      }

      // 합장(공감) — 계정당 한 번, 토글. 문서 하나가 '눌렀음'의 증거다.
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        // 다시 누르면 거둔다 — 제 것만
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid);
      }
    }

    // 나눔에 부쳐진 답 — 부치기는 누구나(비로그인 포함), 검수·삭제는 뒷방만
    match /shared-answers/{id} {
      allow read: if true;
      allow create: if request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // 던져진 화두 — 던지기는 누구나, 살피기·승인·삭제는 뒷방만
    match /thrown/{id} {
      allow create: if request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // 공개된 화두 — 읽기 모두, seen 증가는 누구나, 나머지는 뒷방만
    match /public-hwadu/{id} {
      allow read: if true;
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['seen']);
      allow create, delete: if isAdmin();
    }

    // 함께 드는 수 — 익명 카운터. count 한 칸, ±1 만.
    match /holding/{hwaduId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (request.resource.data.count == 1
            || request.resource.data.count == -1);
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (request.resource.data.count == resource.data.get('count', 0) + 1
            || request.resource.data.count == resource.data.get('count', 0) - 1);
    }

    // 문안 알림 토큰 — 만들고 내리기만. uid 는 본인 것(또는 null)만 새길 수 있다.
    // bells(예불 종 시각)는 그 문서를 아는 이(=토큰 주인 브라우저)만 고칠 수 있다.
    match /push-tokens/{token} {
      allow create: if request.resource.data.keys()
          .hasOnly(['createdAt', 'uid', 'ua', 'bells'])
        && (request.resource.data.uid == null
            || (request.auth != null
                && request.resource.data.uid == request.auth.uid));
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['bells'])
            && request.resource.data.bells is list
            && request.resource.data.bells.size() <= 8);
      allow delete: if true;
      allow read: if isAdmin();
    }

    // 계정 동기화 — 제 것만
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 죽비(피드백) — 보내기는 누구나, 읽기·지우기는 뒷방만
    match /feedback/{id} {
      allow create: if request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── 쪽지 — 공통 판별 ──
    function dmIsAdmin() {
      return request.auth != null
        && (request.auth.uid == "HvYY1QPhLiMLc5NezM1jt0QdUiM2"
            || (request.auth.token.email == "iphonecharging1@gmail.com"
                && request.auth.token.email_verified == true));
    }
    function dmOpen() {
      return true; // 쪽지 전체 개방 스위치 — config.ts DM_ENABLED 와 함께
    }
    function dmOn() {
      return dmOpen() || dmIsAdmin();
    }

    // ── 쪽지 대화 ──
    match /dm-threads/{threadId} {
      // 읽기 — 내 대화만(청한 이·받는 이·멤버). 뒷방은 신고 처리를 위해 전부.
      allow read: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && (request.auth.uid == resource.data.requesterUid
                || request.auth.uid == resource.data.ownerUid
                || request.auth.uid in resource.data.members));
      // 청 넣기 — 내가 requester, 멤버는 [나, 받는 이] 둘, 시작은 pending.
      // 값: 같은 batch 에서 내 지갑의 연꽃이 정확히 1 줄어야 한다(getAfter).
      // 뒷방은 연꽃 없이(도량을 살피는 손길).
      allow create: if dmOn() && request.auth != null
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.ownerUid in request.resource.data.members
        && request.resource.data.status == "pending"
        && (dmIsAdmin()
            || (get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus >= 1
                && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus
                   == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lotus - 1));
      // 고치기 — 멤버만. 멤버·역할은 못 바꾸고, 수락/거절(status)은 받는 이만.
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.requesterUid == resource.data.requesterUid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && (request.resource.data.status == resource.data.status
                || request.auth.uid == resource.data.ownerUid
                || request.resource.data.status == "blocked"));
      allow delete: if dmIsAdmin();

      // 쪽지 낱장 — 수락된 대화의 멤버만 오간다
      match /messages/{messageId} {
        allow read: if dmIsAdmin()
          || (dmOn() && request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members);
        allow create: if dmOn() && request.auth != null
          && request.auth.uid == request.resource.data.uid
          && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members
          && get(/databases/$(database)/documents/dm-threads/$(threadId)).data.status == "accepted";
        allow update, delete: if dmIsAdmin();
      }
    }

    // ── 연꽃 지갑 ──
    match /wallets/{uid} {
      // 내 지갑만 본다 — 뒷방은 채우기 위해 전부
      allow read: if request.auth != null
        && (request.auth.uid == uid || dmIsAdmin());
      // 첫 지갑은 정확히 연꽃 3송이로만 스스로 만들 수 있다(첫 선물) —
      // 문서가 이미 있으면 create 가 막히므로 두 번 받을 수 없다.
      // 채우기는 뒷방 · 본인은 한 송이 차감만(lotus 한 칸, 0 미만 금지).
      allow create: if dmIsAdmin()
        || (dmOn() && request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['lotus'])
            && request.resource.data.lotus == 3);
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['lotus'])
            && request.resource.data.lotus is int
            && request.resource.data.lotus >= 0
            && request.resource.data.lotus == resource.data.lotus - 1);
      allow delete: if dmIsAdmin();
    }

    // ── 연꽃 주문 — 계좌이체 입금 확인 대기열 ──
    match /orders/{orderId} {
      // 주문 넣기 — 로그인한 본인 이름으로, 시작은 pending.
      // 송이수·값은 상품표와 정확히 맞아야 한다 (조작 주문 차단).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == "pending"
        && ((request.resource.data.productId == "lotus-1"
             && request.resource.data.n == 1
             && request.resource.data.price == 1000)
          || (request.resource.data.productId == "lotus-10"
              && request.resource.data.n == 10
              && request.resource.data.price == 9000)
          || (request.resource.data.productId == "lotus-30"
              && request.resource.data.n == 30
              && request.resource.data.price == 24000));
      // 읽기 — 내 주문 + 뒷방 · 처리(지급·삭제)는 뒷방만
      allow read: if dmIsAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update, delete: if dmIsAdmin();
    }

    // ── 신고함 — 쪽지·댓글 신고가 함께 모인다 ──
    match /reports/{reportId} {
      // 신고 넣기 — 로그인한 본인 이름으로만 · 읽기·처리·삭제는 뒷방만
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.byUid
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }

    // ── 서버만 만지는 것들 ──────────────────────────────────────
    //
    // 아래 문서들은 전부 firebase-admin(서버)으로만 쓴다. Admin SDK 는
    // 이 규칙을 지나치므로, 브라우저에는 한 칸도 열지 않는다.
    // ── 모멘트 — 절에 다녀온 한 장 ────────────────────────────
    // 사진은 Storage 대신 문서 안에 담는다(moment.ts 참고). 그래서
    // 글자 수 천장을 여기서 눌러 둔다 — 한 사람이 문서 하나에 몇 MB 를
    // 밀어 넣지 못하게.
    //
    // 「그 자리」 도장은 브라우저의 몫이 아니다 —
    // 만들 때 verified 는 반드시 false, meters 는 null.
    // 뒤집는 것은 관리자 권한으로 도는 /api/moment-stamp 뿐이다.
    match /moments/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.place is string
        && request.resource.data.place.size() > 0
        && request.resource.data.place.size() <= 30
        && request.resource.data.what is string
        && request.resource.data.what.size() > 0
        && request.resource.data.what.size() <= 200
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() <= 220000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.hapjang == 0
        && request.resource.data.verified == false
        && request.resource.data.meters == null;
      allow update: if isAdmin()
        // 합장 — 로그인, ±1
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hapjang'])
            && request.resource.data.hapjang is int
            && (request.resource.data.hapjang == resource.data.get('hapjang', 0) + 1
                || request.resource.data.hapjang == resource.data.get('hapjang', 0) - 1))
        // 본인 손질 — 글·절 이름·해시태그만. 도장은 건드릴 수 없다.
        || (request.auth != null
            && request.auth.uid == resource.data.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['what', 'place', 'tags']));
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);

      // 합장 — 계정당 한 번, 토글
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid);
      }
    }

    // 모멘트의 큰 그림 — 목록은 이 칸을 읽지 않는다. 펼쳤을 때만 한 장.
    match /moment-photos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 900000;
      allow update: if false;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
    }

    // 열어 두면 콘솔 한 줄로 공덕·연꽃·인증이 조작된다.

    // 초 공양 — 법당의 초와 회향의 등.
    // 값(연꽃)은 클라이언트가 지갑에서 거두므로 여기서 다시 셀 수 없다.
    // 대신 **거짓으로 오래 태우지 못하게** until 을 가둔다 —
    // 초는 49일, 등은 이레. 그 위로 적으면 아예 안 써진다.
    match /candles/{id} {
      allow read: if true;
      // 값이 드는 초(tier 'candle')는 **브라우저가 못 세운다** —
      // /api/candle/light 가 지갑과 초를 한 트랜잭션에 묶어 쓴다(Admin SDK).
      // 예전엔 브라우저가 연꽃을 먼저 빼고 문서를 나중에 썼는데, 그 사이에서
      // 엎어지면 연꽃만 사라졌다. 여기 이 규칙이 그 길을 아예 닫는다.
      // 회향의 등(tier 'light')은 값이 안 드니 그대로 브라우저에 열어 둔다.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tier == 'light'
        && request.resource.data.forName is string
        && request.resource.data.forName.size() > 0
        && request.resource.data.forName.size() <= 20
        && request.resource.data.wish is string
        && request.resource.data.wish.size() <= 120
        && request.resource.data.born is string
        && request.resource.data.born.size() <= 4
        && request.resource.data.hapjang == 0
        && request.resource.data.until is int
        && request.resource.data.until > 0
        // 등은 사흘. 기기 시계가 조금 어긋나도 걸리지 않게 하루를 얹어 4일.
        // (초의 날수 상한은 여기 없다 — 초는 서버가 제 시계로 잰다)
        && request.resource.data.until <= request.time.toMillis() + 345600000;
      // 같이 빌기 — 로그인한 사람이 ±1. 그 밖의 칸은 못 건드린다.
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hapjang'])
            && request.resource.data.hapjang is int
            && (request.resource.data.hapjang == resource.data.get('hapjang', 0) + 1
                || request.resource.data.hapjang == resource.data.get('hapjang', 0) - 1));
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
    }

    // 우리 절 — 같은 절 다니는 사람 수만 서버가 세어 내준다(/api/temple)
    match /temple-members/{uid} {
      allow read, write: if false;
    }

    // 절 다녀왔다는 표 — 서버가 좌표로 거리를 다시 재고 적는다
    // (/api/temple-proof). 목록도 서버가 법명만 골라 내준다.
    match /temple-proofs/{id} {
      allow read, write: if false;
    }

    // 공덕 → 연꽃 하루 상한 자국 (/api/lotus/exchange)
    match /merit-exchange/{id} {
      allow read, write: if false;
    }

    // 경전 완주 — 같은 경전을 두 번 쳐도 연꽃은 한 번 (/api/lotus/sutra)
    match /sutra-clears/{id} {
      allow read, write: if false;
    }

    // 하루 순위 · 외우기 순위 (/api/rank)
    match /rank-daily/{id} {
      allow read, write: if false;
    }
    match /rank-sutra/{id} {
      allow read, write: if false;
    }

    // 알림 발송 상한 (/api/push/*)
    match /notify-limits/{id} {
      allow read, write: if false;
    }

    // ── 함께 켜는 초 — 회향이 모이는 여섯 자리 ──────────────
    // 법당 문 앞의 촛대다. 누구나 보되 아무도 못 적는다.
    // 적는 길은 /api/merit/give 하나뿐이고, 거기서 하루 세 번을 센다.
    // (초 공양 candles 와 달리 문서가 여섯 개로 고정이라, 한 번
    //  더럽혀지면 지우고 다시 세울 것이 없다 — 그래서 더 꽉 잠근다)
    match /hall/{seatId} {
      allow read: if true;
      allow write: if false;
    }

    // 하루 세 번 셈 — 내 것만 본다(오늘 몇 번 남았나를 앱이 묻는다)
    match /giving/{id} {
      allow read: if request.auth != null && id.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // 멱등표 — 서버끼리만 쓰는 표라 읽을 일도 없다
    match /gifts/{id} {
      allow read, write: if false;
    }

    // ── 인연 · 도반 찾기 ─────────────────────────────────────
    // 형: 「인연으로 데이팅앱 갈 거야. 가입할 때 사진 무조건 넣어야 하고,
    //      매칭되면 서로 쪽지합 열리게」
    //
    // 프로필은 **활동 중이고 통과된 사진이 있는 것만** 남이 읽는다.
    // 심사중·쉼·정지는 본인과 뒷방만 본다 — 얼굴 없는 계정이 판에 서면
    // 그 판의 값이 통째로 깎인다.
    match /yeon-profiles/{uid} {
      // 규칙 언어는 한글 이름을 못 쓴다 — 뜻은 「활동 중이고 사진이 있다」
      function isOpen() {
        return resource.data.state == '활동'
          && resource.data.photos.size() > 0;
      }
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid)
        || (request.auth != null && isOpen());

      // 제 것만 쓴다. 바꿀 수 없는 것 둘 —
      //  · state 를 '정지' 로는 스스로 못 간다(뒷방 몫)
      //  · 사진의 통과 여부(photos[].state)는 손댈 수 없어야 하지만
      //    규칙으로 배열 속을 못 보므로, **통과 표시는 서버(API)에서만**
      //    찍는다. 여기서는 올리는 것까지만 허락한다
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.state != '정지');
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // 합장 — **보낸 것만** 쓴다. 받은 목록은 서버로만 센다.
    // 「누가 나에게 합장했나」가 연꽃으로 파는 것이라, 클라이언트가
    // 읽을 수 있으면 값이 통째로 무너진다.
    match /yeon-haps/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow update, delete: if isAdmin();
    }

    // 인연이 닿은 것 — 양쪽만 읽는다. 맺고 끊는 것은 서버 몫
    match /yeon-matches/{id} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.pair);
      allow write: if isAdmin();
    }

    // 차단 — 제 목록만
    match /yeon-blocks/{uid}/{other} {
      allow read, write: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
    }
  }
}
