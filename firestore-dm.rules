// ─────────────────────────────────────────────────────────────
// 쪽지(書信) 규칙 — dm-threads / wallets / reports
//
// 붙이는 곳: Firebase 콘솔 > Firestore Database > 규칙 탭에서,
// 기존 규칙의 닫는 중괄호 두 개( } } ) 바로 위에 이 블록 전체를
// 붙여넣고 [게시]를 누른다. 기존 규칙은 건드리지 않는다.
//
// 여닫기: 쪽지를 모두에게 열 때 아래 dmOpen()을 true로 바꾸고,
// 코드의 src/lib/config.ts DM_ENABLED 도 함께 true로 바꾼다.
// 지금은 둘 다 false — 관리자만 통과한다.
// ─────────────────────────────────────────────────────────────

    // ── 쪽지 — 공통 판별 ──
    function dmIsAdmin() {
      return request.auth != null
        && request.auth.uid == "HvYY1QPhLiMLc5NezM1jt0QdUiM2";
    }
    function dmOpen() {
      return false; // 쪽지 전체 개방 스위치 — config.ts DM_ENABLED 와 함께
    }
    function dmOn() {
      return dmOpen() || dmIsAdmin();
    }

    // ── 쪽지 대화 ──
    match /dm-threads/{threadId} {
      // 읽기 — 내 대화만(청한 이·글쓴이·멤버). 뒷방은 신고 처리를 위해 전부.
      allow read: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && (request.auth.uid == resource.data.requesterUid
                || request.auth.uid == resource.data.ownerUid
                || request.auth.uid in resource.data.members));
      // 청 넣기 — 내가 requester, 멤버는 [나, 글쓴이] 둘, 시작은 pending
      allow create: if dmOn() && request.auth != null
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.ownerUid in request.resource.data.members
        && request.resource.data.status == "pending";
      // 고치기 — 멤버만. 멤버·역할은 못 바꾸고, 수락/거절(status)은 글쓴이만.
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null
            && request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.requesterUid == resource.data.requesterUid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && (request.resource.data.status == resource.data.status
                || request.auth.uid == resource.data.ownerUid));
      allow delete: if dmIsAdmin();

      // 쪽지 낱장 — 수락된 대화의 멤버만 오간다
      match /messages/{messageId} {
        allow read: if dmIsAdmin()
          || (dmOn() && request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members);
        allow create: if dmOn() && request.auth != null
          && request.auth.uid == request.resource.data.uid
          && request.auth.uid in get(/databases/$(database)/documents/dm-threads/$(threadId)).data.members
          && get(/databases/$(database)/documents/dm-threads/$(threadId)).data.status == "accepted";
        allow update, delete: if dmIsAdmin();
      }
    }

    // ── 연꽃 지갑 ──
    match /wallets/{uid} {
      // 내 지갑만 본다 — 뒷방은 채우기 위해 전부
      allow read: if request.auth != null
        && (request.auth.uid == uid || dmIsAdmin());
      // 채우기는 뒷방만(PG 전 시험용) · 본인은 한 송이 차감만
      allow create: if dmIsAdmin();
      allow update: if dmIsAdmin()
        || (dmOn() && request.auth != null && request.auth.uid == uid
            && request.resource.data.lotus == resource.data.lotus - 1);
      allow delete: if dmIsAdmin();
    }

    // ── 신고함 ──
    match /reports/{reportId} {
      // 신고 넣기 — 로그인한 본인 이름으로만 · 읽기·처리·삭제는 뒷방만
      allow create: if dmOn() && request.auth != null
        && request.auth.uid == request.resource.data.byUid
        && request.resource.data.status == "open";
      allow read, update, delete: if dmIsAdmin();
    }
