{
  "rules": {
    "presence": {
      ".read": true,
      "$sessionId": {
        ".write": "$sessionId.length <= 40",
        ".validate": "newData.val() === true"
      }
    },
    "hall-seats": {
      ".read": true,
      "$seat": {
        ".write": "auth != null && $seat.matches(/^([0-9]|1[0-1])$/) && (!data.exists() || data.child('uid').val() === auth.uid || data.child('at').val() < now - 43200000) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'name', 'hue', 'at'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "hue": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}
